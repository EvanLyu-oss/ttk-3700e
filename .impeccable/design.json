      "kind": "button",
      "refersTo": "button-primary",
      "description": "Cobalt action for the primary path into application evidence.",
      "html": "<a class=\"ds-btn-primary\" href=\"#applications\">View applications <svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-btn-primary{display:inline-flex;min-height:45px;align-items:center;justify-content:space-between;gap:20px;padding:11px 15px;color:var(--white);background:var(--accent);border:1px solid var(--accent);border-radius:6px;font-family:var(--font);font-size:12px;font-weight:650;line-height:1.4;text-decoration:none;transition:background .2s,color .2s,border-color .2s}.ds-btn-primary:hover{background:#0d51b1;border-color:#0d51b1}.ds-btn-primary:focus-visible{outline:3px solid #3b82e6;outline-offset:3px}.ds-icon{width:1.2em;height:1.2em;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}"
    },
