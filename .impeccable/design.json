      "css": ".ds-qualification{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;color:#85450f;background:var(--white);border:1px solid currentColor;border-radius:30px;font-family:var(--font);font-size:12px;font-weight:650;line-height:1.4}.ds-icon{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Download Link",
      "kind": "button",
